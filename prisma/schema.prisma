generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Media {
  id            String   @id @default(cuid())

  // Where this came from
  source        String   @default("telegram")  // "telegram" | "drive"

  // Telegram identifiers (nullable for non-telegram sources)
  tgChatId      String?
  tgMessageId   String?
  tgFileId      String?
  tgUniqueId    String?  @unique

  // Google Drive identifiers
  driveFileId   String?  @unique
  drivePath     String?

  kind          String   // "photo" | "video" | "animation" | "document"
  mime          String?
  width         Int?
  height        Int?
  duration      Int?     // seconds, for video
  bytes         Int?

  // Files on disk, relative to MEDIA_DIR
  filePath      String
  thumbPath     String?

  caption       String?
  takenAt       DateTime?
  importedAt    DateTime @default(now())

  favorite      Boolean  @default(false)
  hidden        Boolean  @default(false)
  isHero        Boolean  @default(false)

  tags          MediaTag[]

  @@index([importedAt])
  @@index([kind])
  @@index([favorite])
  @@index([isHero])
  @@index([source])
}

model Tag {
  id     String     @id @default(cuid())
  name   String     @unique
  media  MediaTag[]
}

model MediaTag {
  mediaId String
  tagId   String
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId],   references: [id], onDelete: Cascade)
  @@id([mediaId, tagId])
}

/// One row per source ("telegram", "drive"). Stores cursor + last error.
model SyncState {
  source        String   @id  // "telegram" | "drive"
  cursor        String?       // tg: lastMessageId; drive: changes pageToken
  lastRunAt     DateTime?
  lastError     String?
}
