# Copy to .env.local and fill in. NEVER commit .env.local

# --- Auth (single user) ---
# Run `npm run set-password` to generate the hash, then paste it here.
# IMPORTANT: every $ in the hash MUST be escaped with \, e.g.
#   AUTH_PASSWORD_HASH=\$2a\$12\$abc...
# Otherwise Next.js's env loader will interpolate $2a, $12, $abc as undefined
# variables and your hash will be silently corrupted.
# `set-password` prints it pre-escaped — just paste verbatim.
AUTH_USERNAME=ascended
AUTH_PASSWORD_HASH=
# 32+ random chars; e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Database ---
DATABASE_URL="file:./data/ascended.db"

# --- Media storage (local) ---
MEDIA_DIR=./media

# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# After first login this gets written by `npm run sync:login`. Keep it secret.
TG_SESSION=

# Optional: which chat to pull from. "me" = Saved Messages
TG_SOURCE=me
# Polling interval seconds for catch-up scans
TG_SYNC_INTERVAL=60

# --- Google Drive ---
# Path to your OAuth client JSON (create at console.cloud.google.com)
GOOGLE_CREDENTIALS_PATH=./secrets/google-credentials.json
# Token file written by `npm run drive:login`
GOOGLE_TOKEN_PATH=./secrets/google-token.json
# Drive folder ID to pull from (paste folder URL, take the part after /folders/)
# Leave blank to scan everything you own (heavy — not recommended)
DRIVE_FOLDER_ID=
# Polling interval seconds for change-feed catch-up
DRIVE_SYNC_INTERVAL=120
