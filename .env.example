# Copy to .env.local and fill in. NEVER commit .env.local

# --- Auth (single user) ---
# Run `npm run set-password` to generate the hash, then paste it here
AUTH_USERNAME=ascended
AUTH_PASSWORD_HASH=
# 32+ random chars; e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Database ---
DATABASE_URL="file:./data/ascended.db"

# --- Media storage (local) ---
MEDIA_DIR=./media

# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# After first login this gets written by `npm run sync:login`. Keep it secret.
TG_SESSION=

# Optional: which chat to pull from. "me" = Saved Messages
TG_SOURCE=me
# Polling interval seconds for catch-up scans
TG_SYNC_INTERVAL=60
